 using content::BrowserThread;
 using content::ChildProcessSecurityPolicy;
 
 namespace {
 
+#if BUILDFLAG(IS_LINUX)
+bool ArdiaShellTakesLaunchUrls(const base::CommandLine& command_line,
+                               const base::FilePath& cur_dir,
+                               Profile* profile,
+                               bool process_startup) {
+  std::vector<GURL> urls;
+  for (const StartupTab& tab : StartupTabProviderImpl().GetCommandLineTabs(
+           command_line, cur_dir, profile)) {
+    urls.push_back(tab.url);
+  }
+  return ardia::TakeLinuxLaunchUrls(command_line, urls, process_startup);
+}
+#endif
